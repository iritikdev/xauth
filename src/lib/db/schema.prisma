generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}



enum Role {
  USER
  ADMIN
}
model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Personal Details
  name       String?
  fatherName String?
  motherName String?
  photoUrl   String?

  role       Role     @default(USER)

  kycDocument KycDocument?
  Wallet      Wallet?

  totalBv Float @default(0) 

  address  String?
  district String?
  state    String?
  pincode  String?

  accountNo String
  branch    String?
  ifsc      String?
  upiId     String?

  // Nominee Additions
  nomineeName     String?
  nomineeRelation String?
  nomineeMobile   String?
  nomineeAadhaar  String?

  email     String
  mobile    String @unique
  panNumber String
  aadharNo  String

  // Credentials
  username String @unique
  password String

  // MLM Hierarchy
  sponsorId String? // ID of the user who referred this user
  sponsor   User?   @relation("SponsorRelation", fields: [sponsorId], references: [username], onDelete: NoAction, onUpdate: NoAction)
  downlines User[]  @relation("SponsorRelation")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Counter {
  id    String @id @default("userId") @map("_id")
  value Int
}

model KycDocument {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  // This side is correct, but it needed the 'kycDocument' field above in User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document URLs (Cloudinary)
  aadharFrontUrl String? // Front
  aadharBackUrl  String? // Back
  panUrl         String?
  passbookUrl    String?

  // Verification Logic
  status     KycStatus @default(NOT_SUBMITTED)
  remarks    String?
  verifiedAt DateTime?
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Wallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  balance   Float    @default(0.0)
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  amount      Float
  type        TransactionType // e.g., CREDIT, DEBIT
  status      TransactionStatus // e.g., PENDING, COMPLETED, FAILED
  description String
  createdAt   DateTime          @default(now())
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Product {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float // MRP
  discount    Float       @default(0) // 5% to 20% for associates
  bvAmount    Float // Business Volume for MLM calculation
  image       String
  stock       Int         @default(0)
  categoryId  String      @db.ObjectId
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Category {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?    // To store the category thumbnail URL
  
  // Relations
  products    Product[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}



model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  userId       String      @db.ObjectId
  user         User        @relation(fields: [userId], references: [id])
  items        OrderItem[]
  totalAmount  Float
  totalBv      Float       // Total BV for this order
  status       OrderStatus @default(PENDING)
  paymentStatus String     @default("UNPAID")
  address      String
  createdAt    DateTime    @default(now())
}
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  productId String  @db.ObjectId
  quantity  Int
  bv        Float
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// Blog and Content Management
model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String
  content     String   // HTML or Markdown
  image       String   // Cloudinary URL
  category    String   // Network Marketing, Training, etc.
  authorName  String   @default("Amaze Ayurveda Admin")
  readTime    String   @default("5 min read")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}