model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Personal Details
  name       String?
  fatherName String?
  motherName String?
  photoUrl   String?

  kycDocument KycDocument?

  address  String?
  district String?
  state    String?
  pincode  String?

  accountNo String
  branch    String?
  ifsc      String?
  upiId           String?

  // Nominee Additions
  nomineeName     String?
  nomineeRelation String?
  nomineeMobile   String?
  nomineeAadhaar  String?

  email     String
  mobile    String @unique
  panNumber String
  aadharNo  String

  // Credentials
  username String @unique
  password String

  // MLM Hierarchy
  sponsorId String? // ID of the user who referred this user
  sponsor   User?   @relation("SponsorRelation", fields: [sponsorId], references: [username], onDelete: NoAction, onUpdate: NoAction)
  downlines User[]  @relation("SponsorRelation")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Counter {
  id    String @id @default("userId") @map("_id")
  value Int
}


model KycDocument {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  
  // This side is correct, but it needed the 'kycDocument' field above in User
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document URLs (Cloudinary)
  aadharUrl   String?
  panUrl      String?
  passbookUrl String?

  // Verification Logic
  status      KycStatus @default(NOT_SUBMITTED)
  remarks     String?   
  verifiedAt  DateTime?
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}
